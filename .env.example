# 复制此文件为 .env，按实际填写

# MySQL（宿主机已有实例）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=projectflow
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password

# Redis（宿主机已有实例）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 密钥（至少32位）
JWT_SECRET=change-me-to-a-secure-32-plus-byte-secret

# 存储后端（aliyun-oss | local）
PROJECTFLOW_STORAGE_TYPE=aliyun-oss

# 阿里云 OSS（PROJECTFLOW_STORAGE_TYPE=aliyun-oss 时必填）
ALIYUN_OSS_ACCESS_KEY_ID=your_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_OSS_BUCKET=company-project-oss
